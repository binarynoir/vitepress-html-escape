{
  "name": "@binarynoir/vitepress-html-escape",
  "version": "0.4.0",
  "description": "Stop stray angle brackets and {{ }} in VitePress 2 Markdown from breaking the build: unbalanced tags like Array<string> render as text, real HTML and components are left alone.",
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "markdown-it",
    "markdown-it-plugin",
    "escape",
    "html",
    "vue",
    "docs",
    "documentation"
  ],
  "license": "MIT",
  "author": "BinaryNoir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binarynoir/vitepress-html-escape.git"
  },
  "homepage": "https://github.com/binarynoir/vitepress-html-escape#readme",
  "bugs": {
    "url": "https://github.com/binarynoir/vitepress-html-escape/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress.d.ts",
      "import": "./dist/vitepress.js",
      "require": "./dist/vitepress.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "peerDependencies": {
    "markdown-it": "^15.0.0",
    "vitepress": "^1.0.0 || ^2.0.0-0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@binarynoir/vitepress-markdown-tags": "^0.2.3",
    "@types/node": "^26.6.4",
    "@vue/compiler-dom": "^3.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.1",
    "markdown-it": "^15.0.2",
    "markdown-it-glossary": "^0.4.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1",
    "vue": "^3.5.0"
  }
}
